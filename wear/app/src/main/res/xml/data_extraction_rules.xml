<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the watch: the saved panel address is a credential -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
